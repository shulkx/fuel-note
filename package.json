{
  "name": "fuel-note",
  "version": "1.6.0-beta.1",
  "private": true,
  "description": "油记（Scripting 脚本）的类型检查与 Node 测试。运行时不需要这些依赖。",
  "repository": "github:shulkx/fuel-note",
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "bump": "node tools/version.mjs",
    "probe:install": "node tools/install_probe.mjs",
    "check:install": "node tools/install_check.mjs",
    "device-check": "tsx tools/device_check.ts",
    "ocr-bridge": "node tools/ocr_bridge.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
